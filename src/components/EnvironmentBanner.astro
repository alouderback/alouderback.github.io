---
import { ENV, BUILD } from '../lib/env';
import { flag } from '../lib/flags';

// Production runs without a banner. Everywhere else announces itself, the same
// way a Salesforce sandbox does, so nobody mistakes a Test URL for the real one.
const show = !ENV.isProd;
const isRc = flag('showReleaseCandidate');
---

{
  show && (
    <div class="env-banner" role="status">
      <div class="wrap inner">
        <span class="dot" aria-hidden="true" />
        <strong>{ENV.name}</strong>
        <span class="sep" aria-hidden="true">
          /
        </span>
        <span class="detail">
          {ENV.sfAnalogue}. Deployed from <code>{ENV.branch}</code>.
        </span>
        {isRc && <span class="rc">Release candidate {BUILD.shortSha}</span>}
      </div>
    </div>
  )
}

<style>
  .env-banner {
    background: var(--accent-soft);
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    font-size: 0.83rem;
    color: var(--text);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding-block: 0.5rem;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  strong {
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.74rem;
    color: var(--accent-text);
  }
  .sep {
    color: var(--text-faint);
  }
  .detail {
    color: var(--text-muted);
  }
  code {
    font-family: var(--font-mono);
    font-size: 0.92em;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.05em 0.35em;
  }
  .rc {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
  }
  @media (max-width: 640px) {
    .rc {
      margin-left: 0;
    }
  }
</style>
