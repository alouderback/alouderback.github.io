---
import { ALL_ENVIRONMENTS, ENV } from '../lib/env';

// Jump between the three deployed environments, the way you would switch orgs.
// Each entry points at the same page in a different deployment.
---

<div class="org-switcher">
  <button
    type="button"
    class="trigger"
    aria-expanded="false"
    aria-controls="org-menu"
    data-org-trigger
  >
    <span class="dot" aria-hidden="true"></span>
    <span class="label">{ENV.name}</span>
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
    </svg>
  </button>

  <ul class="menu" id="org-menu" hidden data-org-menu>
    <li class="menu-head">Environments</li>
    {
      ALL_ENVIRONMENTS.map((e) => (
        <li>
          <a href={e.url} data-env-key={e.key} aria-current={e.isCurrent ? 'true' : undefined}>
            <span class={`swatch swatch--${e.key}`} aria-hidden="true" />
            <span class="text">
              <span class="name">{e.name}</span>
              <span class="branch">{e.branch}</span>
            </span>
            {e.isCurrent && <span class="here">current</span>}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  const trigger = document.querySelector<HTMLButtonElement>('[data-org-trigger]');
  const menu = document.querySelector<HTMLElement>('[data-org-menu]');

  function close() {
    if (!trigger || !menu) return;
    menu.hidden = true;
    trigger.setAttribute('aria-expanded', 'false');
  }

  trigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!menu) return;
    const willOpen = Boolean(menu.hidden);
    menu.hidden = !willOpen;
    trigger.setAttribute('aria-expanded', String(willOpen));
  });

  document.addEventListener('click', (e) => {
    if (!menu || menu.hidden) return;
    if (!(e.target instanceof Node)) return;
    if (!menu.contains(e.target) && !trigger?.contains(e.target)) close();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });

  // Keep the reader on the same page when switching environments.
  const links = menu?.querySelectorAll<HTMLAnchorElement>('a[data-env-key]');
  const base = import.meta.env.BASE_URL;
  const rest = window.location.pathname.startsWith(base)
    ? window.location.pathname.slice(base.length)
    : '';
  links?.forEach((a) => {
    a.href = a.href.replace(/\/$/, '/') + rest;
  });
</script>

<style>
  .org-switcher {
    position: relative;
  }
  .trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    padding: 0.3rem 0.55rem;
    border-radius: 7px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.03em;
    cursor: pointer;
  }
  .trigger:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }
  .menu {
    position: absolute;
    right: 0;
    top: calc(100% + 7px);
    min-width: 230px;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    background: var(--surface-raised);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    z-index: 60;
  }
  .menu-head {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--text-faint);
    padding: 0.4rem 0.55rem 0.3rem;
  }
  .menu a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.55rem;
    border-radius: 7px;
    text-decoration: none;
    color: var(--text);
  }
  .menu a:hover {
    background: var(--bg-subtle);
  }
  .swatch {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    flex: none;
  }
  .swatch--dev {
    background: #a78bfa;
  }
  .swatch--qa {
    background: #fbbf24;
  }
  .swatch--prod {
    background: #2dd4bf;
  }
  .text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .name {
    font-size: 0.86rem;
  }
  .branch {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-faint);
  }
  .here {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.63rem;
    color: var(--accent-text);
  }
</style>
